/**
 * ProductCard Module Styles
 * Premium card with sophisticated animations
 */

@keyframes cardEntry {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes imageZoom {
  0% {
    transform: scale(1);
  }
  100% {
    transform: scale(1.08);
  }
}

@keyframes badgePulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.05);
  }
}

.card {
  display: flex;
  flex-direction: column;
  height: 100%;
  border: 1px solid rgba(17, 17, 17, 0.08);
  border-radius: 24px;
  overflow: hidden;
  transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  cursor: pointer;
  text-decoration: none;
  color: inherit;
  min-height: 0;
  animation: cardEntry 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  position: relative;
  box-shadow: 0 4px 24px rgba(17, 17, 17, 0.06),
              0 2px 8px rgba(17, 17, 17, 0.04);
  transform-style: preserve-3d;
  will-change: transform;
}

.card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, 
    rgba(99, 102, 241, 0.03) 0%, 
    rgba(129, 140, 248, 0.03) 100%);
  opacity: 0;
  transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  pointer-events: none;
  border-radius: 24px;
  z-index: 1;
}

.card:hover {
  border-color: rgba(99, 102, 241, 0.2);
  box-shadow: 0 32px 80px rgba(99, 102, 241, 0.15),
              0 16px 40px rgba(17, 17, 17, 0.1);
  transform: translateY(-16px) translateZ(20px);
}

.card:hover::before {
  opacity: 1;
}

.imageContainer {
  position: relative;
  flex-shrink: 0;
  aspect-ratio: 9 / 10;
  background: linear-gradient(135deg, #f5f5f5 0%, #e8e8e8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-bottom: 2px solid var(--color-border);
  transition: all 0.4s ease;
}

.card:hover .imageContainer {
  border-bottom-color: var(--color-accent);
}

.bookIcon {
  font-size: 4.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  filter: drop-shadow(0 8px 24px rgba(0, 0, 0, 0.08));
  will-change: transform;
}

.card:hover .bookIcon {
  transform: scale(1.15) rotate(-5deg) translateZ(30px);
  filter: drop-shadow(0 16px 40px rgba(99, 102, 241, 0.2));
}

.bookImage {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  will-change: transform;
  filter: drop-shadow(0 8px 24px rgba(0, 0, 0, 0.08));
}

.card:hover .bookImage {
  transform: scale(1.08);
  filter: drop-shadow(0 16px 40px rgba(99, 102, 241, 0.2));
}

.badge {
  position: absolute;
  top: 16px;
  right: 16px;
  background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
  color: var(--color-white);
  padding: 8px 16px;
  border-radius: 50px;
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.8px;
  box-shadow: 0 8px 24px rgba(99, 102, 241, 0.3);
  animation: badgePulse 3s ease-in-out infinite;
  z-index: 2;
  text-transform: uppercase;
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.content {
  display: flex;
  flex-direction: column;
  flex: 1;
  padding: 24px;
  position: relative;
  z-index: 2;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.95) 0%, var(--color-lighter) 100%);
}

.info {
  margin-bottom: var(--space-lg);
  flex-shrink: 0;
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 8px;
  min-height: 0;
  overflow: hidden;
}

.title {
  font-size: 0.95rem;
  font-weight: 600;
  margin: 0;
  line-height: 1.3;
  color: var(--color-primary);
  word-break: break-word;
  overflow-wrap: break-word;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  transition: color 0.3s ease;
}

.card:hover .title {
  background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.author {
  font-size: var(--font-size-sm);
  color: var(--color-secondary);
  margin: 0;
  font-weight: 400;
  word-break: break-word;
  overflow-wrap: break-word;
  text-align: left;
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  transition: color 0.3s ease;
}

.card:hover .author {
  color: var(--color-primary);
}

.description {
  font-size: var(--font-size-sm);
  color: var(--color-secondary);
  line-height: 1.5;
  margin: 0 0 var(--space-lg) 0;
  flex: 1;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.rating {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: var(--font-size-sm);
  margin-bottom: var(--space-lg);
  flex-shrink: 0;
}

.stars {
  color: #d4af37;
  letter-spacing: 1px;
  font-weight: 600;
}

.reviews {
  color: var(--color-secondary);
  font-size: var(--font-size-xs);
  font-weight: 500;
}

.priceSection {
  margin-bottom: var(--space-lg);
  flex-shrink: 0;
}

.priceWrapper {
  display: flex;
  align-items: baseline;
  gap: 8px;
}

.price {
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--color-accent);
  transition: all 0.3s ease;
}

.card:hover .price {
  font-size: 1.35rem;
  color: rgba(29,29,31,0.6);
}

.originalPrice {
  font-size: var(--font-size-sm);
  color: var(--color-secondary);
  text-decoration: line-through;
  opacity: 0.7;
}

.addToCart {
  padding: 12px 16px;
  background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
  color: var(--color-white);
  box-shadow: 0 6px 20px rgba(99, 102, 241, 0.25);
  border-radius: 30px;
  font-weight: 600;
  font-size: var(--font-size-sm);
  text-decoration: none;
  transition: all var(--transition-base);
  cursor: pointer;
  border: none;
  flex-shrink: 0;
  margin-top: auto;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.addToCart:hover {
  transform: translateY(-4px) scale(1.01);
  filter: saturate(1.05);
  color: var(--color-white);
  box-shadow: 0 18px 42px rgba(0,0,0,0.12), 0 6px 14px rgba(0,0,0,0.08);
}

.addToCart:active {
  transform: translateY(-1px);
}

/* Responsive */
@media (max-width: 768px) {
  .card {
    aspect-ratio: auto;
  }

  .imageContainer {
    aspect-ratio: 9 / 10;
  }

  .bookIcon {
    font-size: 3rem;
  }

  .title {
    font-size: 0.9rem;
  }

  .content {
    padding: 16px;
  }
}

@media (max-width: 480px) {
  .content {
    padding: var(--space-md);
  }

  .bookIcon {
    font-size: 2.5rem;
  }

  .description {
    display: none;
  }

  .rating {
    margin-bottom: var(--space-md);
  }

  .addToCart {
    padding: 10px 12px;
    font-size: var(--font-size-xs);
  }
}
